{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ExecutionError"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExecutionError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ExecutionError",
        "type": "object"
      },
      "FileEntry": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "file",
              "directory"
            ],
            "title": "Kind",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "size_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "title": "FileEntry",
        "type": "object"
      },
      "FileListing": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "FileListing",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "SandboxConfig": {
        "additionalProperties": false,
        "properties": {
          "image_digest": {
            "title": "Image Digest",
            "type": "string"
          },
          "log_max_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Log Max Bytes",
            "type": "integer"
          },
          "workspace_max_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Workspace Max Bytes",
            "type": "integer"
          }
        },
        "required": [
          "image_digest",
          "workspace_max_bytes",
          "log_max_bytes"
        ],
        "title": "SandboxConfig",
        "type": "object"
      },
      "ToolCheckpoint": {
        "additionalProperties": false,
        "properties": {
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "workspace_version_id": {
            "format": "uuid",
            "title": "Workspace Version Id",
            "type": "string"
          }
        },
        "required": [
          "completed_at",
          "workspace_version_id"
        ],
        "title": "ToolCheckpoint",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "status": {
            "const": "error",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      },
      "ToolExecuteRequest": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Arguments",
            "type": "object"
          },
          "deadline_at": {
            "format": "date-time",
            "title": "Deadline At",
            "type": "string"
          },
          "input_version_id": {
            "format": "uuid",
            "title": "Input Version Id",
            "type": "string"
          },
          "lease_generation": {
            "exclusiveMinimum": 0.0,
            "title": "Lease Generation",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "sandbox": {
            "$ref": "#/components/schemas/SandboxConfig"
          }
        },
        "required": [
          "operation_id",
          "input_version_id",
          "name",
          "arguments",
          "lease_generation",
          "deadline_at",
          "sandbox"
        ],
        "title": "ToolExecuteRequest",
        "type": "object"
      },
      "ToolExecuteResponse": {
        "additionalProperties": false,
        "properties": {
          "output": {
            "discriminator": {
              "mapping": {
                "error": "#/components/schemas/ToolError",
                "ok": "#/components/schemas/ToolSuccess"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/ToolSuccess"
              },
              {
                "$ref": "#/components/schemas/ToolError"
              }
            ],
            "title": "Output"
          },
          "workspace_version_id": {
            "format": "uuid",
            "title": "Workspace Version Id",
            "type": "string"
          }
        },
        "required": [
          "output",
          "workspace_version_id"
        ],
        "title": "ToolExecuteResponse",
        "type": "object"
      },
      "ToolSuccess": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "value": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Value",
            "type": "object"
          }
        },
        "required": [
          "status",
          "value"
        ],
        "title": "ToolSuccess",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceVersion": {
        "additionalProperties": false,
        "properties": {
          "workspace_version_id": {
            "format": "uuid",
            "title": "Workspace Version Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_version_id"
        ],
        "title": "WorkspaceVersion",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Durable Agent Tools",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Liveness Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readiness Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/tools/execute": {
      "post": {
        "operationId": "execute_tool",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolExecuteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolExecuteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Changed input or stale generation"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "Execute Tool"
      }
    },
    "/tools/operations/{operation_id}/checkpoint": {
      "get": {
        "operationId": "get_tool_checkpoint",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ToolCheckpoint"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Tool Checkpoint"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "Get Tool Checkpoint"
      }
    },
    "/tools/workspace-versions/{version_id}/file": {
      "get": {
        "operationId": "download_workspace_file",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Version Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Saved file bytes",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Workspace version or file not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "Download Workspace File"
      }
    },
    "/tools/workspace-versions/{version_id}/files": {
      "get": {
        "operationId": "list_workspace_files",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileListing"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Workspace version not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "List Workspace Files"
      }
    },
    "/tools/workspace/initial": {
      "get": {
        "operationId": "get_initial_workspace",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceVersion"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "Get Initial Workspace"
      }
    }
  }
}
