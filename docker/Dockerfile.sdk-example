# Build both targets from the same checkout and AGENT_BUILD_ID.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /uvx /bin/
WORKDIR /app/backend
ENV UV_LINK_MODE=copy
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/src ./src
RUN uv sync --frozen --no-dev --no-editable \
    && uv build --wheel --out-dir /wheels \
    && uv export --frozen --no-dev --no-emit-project --output-file /constraints.txt
COPY examples/sdk_agent .venv/lib/python3.12/site-packages/sdk_agent

FROM python:3.12-slim AS backend
ARG AGENT_BUILD_ID
RUN test -n "$AGENT_BUILD_ID"
ENV PATH="/app/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    AGENT_BUILD_ID=$AGENT_BUILD_ID
WORKDIR /app/backend
COPY --from=build /app/backend/.venv .venv
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
CMD ["uvicorn", "durable_agent.control.app:app", "--host", "0.0.0.0", "--port", "8000"]

FROM backend AS tools
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker

FROM build AS sandbox-build
# The public SDK needs these libraries, not the backend service dependencies.
RUN uv venv /opt/sandbox \
    && uv pip install --python /opt/sandbox/bin/python \
       --constraint /constraints.txt httpx pydantic pytest==9.1.1 \
    && uv pip install --python /opt/sandbox/bin/python --no-deps /wheels/*.whl
COPY examples/sdk_agent /opt/sandbox/lib/python3.12/site-packages/sdk_agent

FROM python:3.12-slim AS sandbox
ARG AGENT_BUILD_ID
RUN test -n "$AGENT_BUILD_ID"
ENV PATH="/opt/sandbox/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    AGENT_BUILD_ID=$AGENT_BUILD_ID
COPY --from=sandbox-build /opt/sandbox /opt/sandbox
USER 1000:1000
WORKDIR /workspace
